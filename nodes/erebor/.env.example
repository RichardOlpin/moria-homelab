# ==============================================================================
# Environment Configuration for Node 2: erebor (28TB NAS & AI App Server)
# Copy to .env before running `docker compose up -d`
# ==============================================================================

PUID=1000
PGID=1000
# Find your render group ID on Ubuntu with: getent group render | cut -d: -f3
RENDER_GID=109
TZ=America/Denver

# Immich Configuration
IMMICH_VERSION=release
DB_USERNAME=postgres
DB_PASSWORD=change_me_mithril_postgres_secret
DB_DATABASE_NAME=immich
DB_HOSTNAME=immich-postgres
REDIS_HOSTNAME=immich-redis

# AI Coding Workbench (code.moria.lan) Password
CODE_SERVER_PASSWORD=change_me_mellon

# RomM Retro Game Arcade (arcade.moria.lan)
ROMM_DB_PASSWORD=change_me_mithril_romm_pass
ROMM_DB_ROOT_PASSWORD=change_me_mithril_romm_root
ROMM_AUTH_SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Papra Document Vault (docs.moria.lan)
PAPRA_AUTH_SECRET=change_me_generate_with_openssl_rand_hex_32
