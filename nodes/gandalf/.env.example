# ==============================================================================
# Environment Configuration for Node 1: gandalf
# Copy to .env before running `docker compose up -d`
# ==============================================================================

# Your public domain (for friends/family media streaming & Let's Encrypt certs)
PUBLIC_DOMAIN=yourdomain.com
ACME_EMAIL=you@yourdomain.com

# Your internal homelab domain (configured as wildcard DNS rewrite in AdGuard Home)
LOCAL_DOMAIN=moria.lan

# Static LAN IP of Node 2 ('erebor' - 28TB NAS & AI App Server)
EREBOR_IP=192.168.1.20

# Your local subnet for UpSnap Wake-on-LAN scanning (to wake 'balrog')
LAN_SUBNET=192.168.1.0/24
TZ=America/Denver

# Set to 'false' after creating your Vaultwarden account!
VAULTWARDEN_SIGNUPS=true
